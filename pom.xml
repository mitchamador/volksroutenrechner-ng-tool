<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>by.mitchamador</groupId>
    <artifactId>volksroutenrechner-ng-tool</artifactId>
    <version>1.0-SNAPSHOT</version>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- используется только когда активен профиль sqlite (см. <profiles> ниже) -
             по умолчанию не имеет значения, т.к. sqlite-jdbc вообще не входит в сборку -->
        <sqlite.native.include>org/sqlite/native/**</sqlite.native.include>
    </properties>

    <dependencies>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.11.0</version>
        </dependency>
        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
            <version>1.4</version>
        </dependency>
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>6.7.0</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.2</version>
        </dependency>
        <!-- фиксируем версию явно, чтобы не зависеть от порядка разрешения транзитивных версий
             (sqlite-jdbc просит 1.7.36, javalin - 2.0.17; нужна одна версия для всех) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
        </dependency>
        <!-- статика фронтенда (Bootstrap, Font Awesome) вместо ручного вендоринга файлов -
             см. WebServer.start(): config.staticFiles.enableWebjars() -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>bootstrap</artifactId>
            <version>5.3.3</version>
        </dependency>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>font-awesome</artifactId>
            <version>6.4.2</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>by.mitchamador.volksroutenrechner.web.WebApp</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <!-- Оптимизация Font Awesome -->
                                <filter>
                                    <artifact>org.webjars:font-awesome</artifact>
                                    <includes>
                                        <include>META-INF/resources/webjars/font-awesome/*/css/all.min.css</include>
                                        <include>META-INF/resources/webjars/font-awesome/*/webfonts/fa-solid-900.woff2</include>
                                    </includes>
                                </filter>
                                <!-- Оптимизация Bootstrap -->
                                <filter>
                                    <artifact>org.webjars:bootstrap</artifact>
                                    <includes>
                                        <include>META-INF/resources/webjars/bootstrap/*/css/bootstrap.min.css</include>
                                        <include>META-INF/resources/webjars/bootstrap/*/js/bootstrap.bundle.min.js</include>
                                    </includes>
                                </filter>
                                <!-- Нативные библиотеки sqlite-jdbc под все платформы разом тянут ~24 МБ.
                                     По умолчанию sqlite-jdbc вообще не входит в сборку (см. <profiles> -
                                     профиль sqlite), так что этот фильтр просто не к чему применять.
                                     Когда профиль sqlite активен - фильтрует по sqlite.native.include,
                                     который платформенные профили (windows-x64 и т.п.) сужают до одной ОС/архитектуры. -->
                                <filter>
                                    <artifact>org.xerial:sqlite-jdbc</artifact>
                                    <includes>
                                        <include>org/sqlite/**/*.class</include>
                                        <include>META-INF/**</include>
                                        <include>sqlite-jdbc.properties</include>
                                        <include>${sqlite.native.include}</include>
                                    </includes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- По умолчанию (без -P) в jar нет sqlite-jdbc вообще - используется H2 (см. WebApp).
             Чтобы добавить поддержку SQLite обратно:
             mvn clean package -P sqlite                (все платформы, портативно, тяжело)
             mvn clean package -P sqlite,windows-x64     (только нужная платформа, легко)
             Профили ниже сочетаются между собой: "sqlite" добавляет саму зависимость,
             платформенные профили лишь сужают её нативную часть - см. sqlite.native.include. -->
        <profile>
            <id>sqlite</id>
            <dependencies>
                <dependency>
                    <groupId>org.xerial</groupId>
                    <artifactId>sqlite-jdbc</artifactId>
                    <version>3.46.1.0</version>
                    <exclusions>
                        <exclusion>
                            <groupId>org.slf4j</groupId>
                            <artifactId>slf4j-api</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>windows-x64</id>
            <properties>
                <sqlite.native.include>org/sqlite/native/Windows/x86_64/**</sqlite.native.include>
            </properties>
        </profile>
        <profile>
            <id>linux-x64</id>
            <properties>
                <sqlite.native.include>org/sqlite/native/Linux/x86_64/**</sqlite.native.include>
            </properties>
        </profile>
        <profile>
            <id>mac-x64</id>
            <properties>
                <sqlite.native.include>org/sqlite/native/Mac/x86_64/**</sqlite.native.include>
            </properties>
        </profile>
        <profile>
            <id>mac-arm64</id>
            <properties>
                <sqlite.native.include>org/sqlite/native/Mac/aarch64/**</sqlite.native.include>
            </properties>
        </profile>
    </profiles>

</project>
